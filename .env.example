# All optional. Defaults shown.
PORT=7860
MAX_CONCURRENT_RUNS=2        # tests running at the same time; more need more RAM
CHECKPOINT_TIMEOUT_MIN=20    # if the user doesn't answer, continue with best guess after this
RUN_TTL_HOURS=6              # reports and evidence are deleted after this
RUNS_DIR=/tmp/qa-agent-runs
# Development only — never enable on a public server:
# ALLOW_PRIVATE_URLS=true    # allow testing localhost / private IPs
# ENABLE_MOCK_PROVIDER=true  # adds a scripted "Mock" AI for automated tests
