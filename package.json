{
  "name": "qa-agent",
  "version": "0.1.0",
  "description": "AI QA testing agent: give it a URL and an LLM API key, get a full HTML test report.",
  "main": "dist/server/index.js",
  "scripts": {
    "dev:server": "ALLOW_PRIVATE_URLS=true tsx watch server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "e2e": "ALLOW_PRIVATE_URLS=true tsx scripts/e2e.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/deepseek": "^3.0.89",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/groq": "^4.0.86",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "ai": "^7.0.179",
    "archiver": "^8.0.0",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "playwright": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
